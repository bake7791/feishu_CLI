    "KR": "KR:ko",
    "DE": "DE:de",
    "GB": "GB:en"
  },

  "region_flags": {
    "_desc": "地区对应的国旗 emoji",
    "US": "\ud83c\uddfa\ud83c\uddf8",
    "CN": "\ud83c\udde8\ud83c\uddf3",
    "JP": "\ud83c\uddef\ud83c\uddf5",
