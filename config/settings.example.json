  "ai_model": "gpt-4o",
  "max_tokens": 4000,
  "temperature": 0.3,

  "card_char_limit": 4500,
  "summary_card_color": "blue",
  "report_card_color": "green",
  "source_card_color_1": "turquoise",
  "source_card_color_2": "purple",
  "no_news_card_color": "red",
  "no_news_text": "\u4eca\u65e5\u6682\u65e0\u71c3\u6599\u7535\u6c60\u76f8\u5173\u65b0\u95fb\u3002",

  "summary_labels": ["\u6700\u5173\u952e\u4fe1\u53f7", "\u6700\u5927\u673a\u4f1a", "\u6700\u5927\u98ce\u9669"],

  "skip_keywords": [
    "stock", "share price", "sponsored", "advertisement",
    "promoted", "partner content"
  ],

  "rss_time_formats": [
    "%a, %d %b %Y %H:%M:%S %Z",
    "%a, %d %b %Y %H:%M:%S %z",
    "%Y-%m-%dT%H:%M:%S%z",
